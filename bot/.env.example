# Skopiuj do bot/.env (plik jest ignorowany przez git) i uzupelnij wlasnymi danymi.
# Dane osobowe trzymamy TYLKO tutaj - nigdy w plikach *.yaml, ktore trafiaja do repo.

# Adres formularza:
FORM_URL=https://forms.cloud.microsoft/Pages/ResponsePage.aspx?id=TWOJ_IDENTYFIKATOR

# Odpowiedzi:
FORM_IMIE_NAZWISKO=Imie Nazwisko
FORM_NR_ALBUMU=000000
FORM_NR_REJESTRACYJNY=XX00000

# Przyklad z demo:
FORM_EMAIL=jan.kowalski@example.com
