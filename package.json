{
  "name": "lechrol-wz",
  "productName": "Lechrol WZ",
  "version": "1.0.0",
  "description": "Aplikacja do wystawiania dokumentów WZ (wydanie zewnętrzne) — ZPHU Lechrol Jacek Wajcht",
  "main": "main.js",
  "author": "ZPHU Lechrol Jacek Wajcht",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node tests/numbering.test.js",
    "dist": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "pl.lechrol.wz",
    "productName": "Lechrol WZ",
    "win": {
      "target": ["portable"],
      "icon": "assets/icon.ico",
      "artifactName": "Lechrol-WZ-${version}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**"
    ]
  }
}
