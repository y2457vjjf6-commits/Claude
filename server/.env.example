# Skopiuj do .env i uzupełnij. Wczytaj przed startem, np.:
#   set -a && . ./.env && set +a && npm start
# (lub w Node 20+:  node --env-file=.env server.js)

# Port serwera
PORT=3000

# Wersja Graph API
META_GRAPH_VERSION=v21.0

# Długożyjący token strony (Page Access Token) z uprawnieniami:
#   leads_retrieval, pages_manage_metadata, pages_show_list, ads_management
META_ACCESS_TOKEN=

# Dowolny sekret – ten sam wpisz w konfiguracji webhooka w panelu Meta
META_VERIFY_TOKEN=crm-verify-token

# App Secret z aplikacji Meta – włącza weryfikację podpisu X-Hub-Signature-256
META_APP_SECRET=

# ID formularzy Lead Ads do ręcznej synchronizacji (po przecinku)
META_FORM_IDS=
